# ------------------------------
# Core runtime
# ------------------------------

HA_BASE_URL=http://localhost:8123
HA_API_TOKEN=replace-with-long-lived-token
HA_SATELLITE_ENTITY_ID=assist_satellite.example

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
X_OLLAMA_KEY=replace-with-ollama-api-key

# ------------------------------
# Live smoke / runtime checks
# ------------------------------

SMOKE_CONNECT_TIMEOUT_S=3
SMOKE_REQUEST_TIMEOUT_S=10

# ------------------------------
# Optional governance recovery
# ------------------------------

ALLOW_REMOTE_BASE_REF_RECOVERY=false
GIT_ORIGIN_URL=https://github.com/neatbasis/TestBot.git

# ------------------------------
# Optional runtime / storage
# ------------------------------

MEMORY_STORE_MODE=in_memory
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=testbot_memory_cards

# ------------------------------
# Optional source ingest
# ------------------------------

SOURCE_INGEST_ENABLED=0
SOURCE_CONNECTOR_TYPE=fixture
SOURCE_FIXTURE_PATH=
SOURCE_INGEST_CURSOR=
SOURCE_MARKDOWN_PATH=
SOURCE_WIKIPEDIA_TOPIC=
SOURCE_WIKIPEDIA_LANGUAGE=en
SOURCE_ARXIV_QUERY=
SOURCE_INGEST_ASYNC_CONTINUATION=0
SOURCE_INGEST_OBLIGATION_TIMEOUT_SECONDS=900

# ------------------------------
# Optional debug / evaluation
# ------------------------------

TESTBOT_DEBUG=0
TESTBOT_DEBUG_VERBOSE=0
TESTBOT_RERANK_OBJECTIVE_CONFIG=

# ------------------------------
# Optional tracing / observability
# ------------------------------

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-me
LANGCHAIN_API_KEY=replace-me
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=TestBot
